# ============================================================
# DocGuard Agent 环境变量示例
# 复制为 .env 后填写实际值
# ============================================================

# ===== LLM 配置 (OpenAI 兼容) =====
# API Key（必填）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Base URL（兼容 OpenAI 协议的服务均可，例如：
#   - OpenAI 官方:    https://api.openai.com/v1
#   - 阿里云百炼:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 硅基流动:      https://api.siliconflow.cn/v1
#   - DeepSeek:      https://api.deepseek.com/v1
#   - Ollama 本地:   http://localhost:11434/v1
# ）
LLM_BASE_URL=https://api.openai.com/v1

# 聊天模型名称（如 gpt-4o-mini / qwen-plus / deepseek-chat 等）
LLM_CHAT_MODEL=gpt-4o-mini

# Embedding 模型名称（如 text-embedding-3-small / text-embedding-v3 等）
LLM_EMBEDDING_MODEL=text-embedding-3-small

# 推理参数
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# ===== ChromaDB 配置 =====
CHROMA_PERSIST_DIRECTORY=output/chroma_db
CHROMA_COLLECTION_NAME=docguard_knowledge
CHROMA_TOP_K=5
CHROMA_SIMILARITY_THRESHOLD=0.7

# ===== 路径配置 =====
OUTPUT_DIR=output
LOGS_DIR=output/logs
REPORTS_DIR=output/reports
REPAIRED_DIR=output/repaired
KNOWLEDGE_DIR=knowledge_docs
RULES_DIR=rules

# ===== Agent 配置 =====
# 修复-验证最大迭代次数
MAX_REVIEW_ITERATIONS=3
# 是否启用自动修复
AUTO_REPAIR_ENABLED=true
# 是否启用验证阶段
VALIDATION_ENABLED=true

# ===== 日志配置 =====
LOG_LEVEL=INFO
